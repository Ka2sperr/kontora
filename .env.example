# Skopiuj ten plik do `.env` i uzupelnij. `.env` jest ignorowany przez gita.
# Kazda zmienna jest walidowana schematem Zod przy starcie aplikacji
# (src/infrastructure/config/env.ts) — brak lub zly format = natychmiastowy
# blad startu, nigdy cicha awaria w polowie zadania.

# Connection string do Postgresa.
# Dla lokalnego `docker compose up` wartosc ponizej jest gotowa do uzycia.
DATABASE_URL=postgres://kontora:kontora_dev@localhost:5432/kontora

# Tryb pracy: development | test | production.
# Ustawiany automatycznie przez Next.js i Vitest — nadpisuj tylko swiadomie.
NODE_ENV=development

# Klucz podpisujacy tokeny dostepu (HS256). Minimum 32 znaki.
# Wygeneruj wlasny: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Zmiana tej wartosci uniewaznia wszystkie wydane tokeny dostepu, czyli wylogowuje
# wszystkich. To jest zamierzone i bywa przydatne.
AUTH_SECRET=zmien-mnie-na-losowy-ciag-o-dlugosci-co-najmniej-32-znakow

# Sprawdzanie hasel w bazie wyciekow Have I Been Pwned (model k-anonimowosci:
# wysylanych jest piec pierwszych znakow skrotu SHA-1, nigdy haslo).
# Ustaw false przy pracy bez dostepu do sieci.
HIBP_ENABLED=true

# Limit czasu na odpowiedz HIBP. Po jego przekroczeniu rejestracja idzie dalej —
# niedostepnosc cudzego serwera nie moze blokowac zakladania konta.
HIBP_TIMEOUT_MS=3000
